rules_version = '2';
// TEKNO – Firestore szabályok. Firebase konzol → Firestore Database → Rules → beillesztés → Publish.
// Olvasás: bárki (az Abigél üzleti eset REST-en olvassa a ticketReport-ot; a katalógus nyilvános).
// Írás: csak bejelentkezett kliens (az index.html névtelenül bejelentkezik; ehhez Authentication → Sign-in method → Anonymous: Enable).
service cloud.firestore {
  match /databases/{database}/documents {
    match /services/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ticketReport/{id} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.data.keys().hasAll(['sec','y','m','metric','dim','value'])
        && request.resource.data.value is number;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
